{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["node", "vite/client"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true
	},
	"include": ["lib", "facets", "site"],
	"exclude": ["site/dist"]
}
