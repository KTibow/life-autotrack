# where the life repo is, relative to this repo (default: sibling ../life)
# LIFE_DIR=../life

# — schoology: an app's consumer key/secret + your user's access token/secret
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=
SCHOOLOGY_TOKEN_KEY=
SCHOOLOGY_TOKEN_SECRET=
# district web host, for links in digests and the site
SCHOOLOGY_HOST=app.schoology.com
# attachments bigger than this are recorded but not downloaded
# MAX_FILE_MB=250

# — Google (Drive links in Schoology get followed through a real browser session)
# a Chromium profile used only for this; sign in once with `pnpm google:login`
# CHROMIUM_PROFILE_DIR=/home/you/.config/life-autotrack-chromium
# how to start Chromium; for the flatpak, put the profile somewhere the sandbox can see,
# e.g. ~/.var/app/org.chromium.Chromium/config/life-autotrack
# CHROMIUM_COMMAND=flatpak run org.chromium.Chromium
# the browser runs in a window (that's where 2FA happens); cron needs to know the display
# DISPLAY=:0
# re-export Google Docs/Sheets/Slides at least this often (hours)
# DRIVE_RECHECK_HOURS=12
# DRIVE_MAX_FOLDER_FILES=2000

# — studentvue
STUDENTVUE_HOST=wa-nor-psv.edupoint.com
STUDENTVUE_USERNAME=
STUDENTVUE_PASSWORD=

# — site publishing (private R2 bucket; everything lands under PUBLISH_PREFIX/)
# pick something unguessable, e.g. `openssl rand -hex 16`
PUBLISH_PREFIX=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
