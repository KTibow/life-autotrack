# where the life repo is, relative to this repo (default: sibling ../life)
# LIFE_DIR=../life

# — schoology: an app's consumer key/secret + your user's access token/secret
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=
SCHOOLOGY_TOKEN_KEY=
SCHOOLOGY_TOKEN_SECRET=
# district web host, for links in digests and the site
SCHOOLOGY_HOST=app.schoology.com
# attachments bigger than this are recorded but not downloaded
# MAX_FILE_MB=250

# — Google (Drive links in Schoology get followed through a real browser session)
# a Chromium profile used only for this; sign in once with `pnpm google:login`
# CHROMIUM_PROFILE_DIR=~/.config/life-autotrack-chromium
# how to start Chromium; for the flatpak, put the profile somewhere the sandbox can see,
# e.g. ~/.var/app/org.chromium.Chromium/config/life-autotrack
# CHROMIUM_COMMAND=flatpak run org.chromium.Chromium
# tracker runs use it headless; only `pnpm google:login` opens a window (found automatically
# over ssh when someone's logged in to the desktop; else set DISPLAY / XAUTHORITY here)
# CHROMIUM_HEADLESS=0   # to keep tracker runs headed, if Google ever balks at headless
# re-export Google Docs/Sheets/Slides at least this often (hours)
# DRIVE_RECHECK_HOURS=12
# DRIVE_MAX_FOLDER_FILES=2000
# how many hops of links to follow from inside Docs/Sheets/decks (0 = none)
# DRIVE_LINK_DEPTH=2

# — Google Sites: start URL(s), comma-separated; public sites need nothing else, district
# sites use the Google browser session above
# GOOGLE_SITES=https://sites.google.com/view/some-class-site

# — documents (PDF, Word, PowerPoint, Google Docs/Slides) → markdown; defaults shown
# MARKITDOWN_COMMAND=uvx --quiet --from markitdown[docx,pptx,pdf]==0.1.8 markitdown
# optional: PDFs of Word/PowerPoint uploads, and reading old .doc/.ppt/.odt
# SOFFICE_COMMAND=soffice

# — studentvue
STUDENTVUE_HOST=wa-nor-psv.edupoint.com
STUDENTVUE_USERNAME=
STUDENTVUE_PASSWORD=

# — site publishing (private R2 bucket; everything lands under PUBLISH_PREFIX/)
# pick something unguessable, e.g. `openssl rand -hex 16`
PUBLISH_PREFIX=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
